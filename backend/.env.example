# Server
PORT=5000
NODE_ENV=development

# Aiven PostgreSQL (copy from the Aiven service overview page)
DB_HOST=your-service-yourproject.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=kobopay_db

# SSL (required by Aiven)
DB_SSL=true
DB_SSL_CA_PATH=./certs/ca.pem

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# CORS: the frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000

# ── Paystack ──────────────────────────────────────────────────────────────────
# Use test keys (sk_test_...) locally/staging and live keys (sk_live_...) only
# in your production environment. Never commit real keys.
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Not used by the redirect checkout flow; kept for future Paystack Inline use.
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
# Must be a frontend URL (not the backend API URL). Paystack redirects here.
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback
# Optional. Paystack signs webhooks with PAYSTACK_SECRET_KEY; set this only if
# you deliberately use a separate signing value.
PAYSTACK_WEBHOOK_SECRET=
# Optional overrides (defaults shown)
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_TIMEOUT_MS=15000

# Deposit limits (whole NGN) and endpoint throttling (defaults shown)
# PAYMENT_MIN_NGN=100
# PAYMENT_MAX_NGN=1000000
# PAYMENT_RATE_LIMIT_WINDOW_MS=60000
# PAYMENT_INIT_RATE_LIMIT=10
# PAYMENT_VERIFY_RATE_LIMIT=30
